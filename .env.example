# Copy to .env.local and adjust. Values here are public (they end up in the browser bundle).

# Public site address, used for canonical and social-share tags. No trailing slash.
VITE_SITE_URL=https://roboneura.com

# Deploying into a sub-folder? Set the folder path with leading and trailing slash.
# VITE_BASE=/roboneura/

# Form delivery. Any service that accepts a JSON POST works (Formspree, Getform, Web3Forms, your own API).
# Example: https://formspree.io/f/abcdwxyz
# Without it: `npm run dev` shows a demo success message; a production build asks the
# visitor to send the (pre-filled) message from their email app, so no enquiry is lost.
VITE_FORM_ENDPOINT=
VITE_NEWSLETTER_ENDPOINT=
