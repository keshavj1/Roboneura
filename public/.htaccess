# ROBONEURA website: Apache configuration for the single-page app.
# Upload this file together with the contents of dist/ (it is hidden on some systems;
# in FileZilla enable Server > Force showing hidden files).

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve real files and folders as they are.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # A missing file with an extension (e.g. /images/old.png) is a real 404, not the app.
  RewriteCond %{REQUEST_URI} \.[a-z0-9]{2,5}$ [NC]
  RewriteRule ^ - [R=404,L]

  # Everything else is a page route (/about, /industries, ...) handled by the app.
  # Relative target, so this also works when the site lives in a sub-folder.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
  # Build files in /assets/ have content hashes in their names and never change.
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Photos can be swapped by name, so cache them for a week only.
  <If "%{REQUEST_URI} =~ m#/images/#">
    Header set Cache-Control "public, max-age=604800"
  </If>
  # Always re-check the HTML so visitors pick up new deployments.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
